{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ForecastBatch",
  "$comment": "Structural validation only; use Python contract validators for cross-field invariants.",
  "type": "object",
  "properties": {
    "forecast_batch_id": {
      "type": "string",
      "minLength": 1
    },
    "context_id": {
      "type": "string",
      "minLength": 1
    },
    "producer_id": {
      "type": "string",
      "minLength": 1
    },
    "producer_version": {
      "type": "string",
      "minLength": 1
    },
    "created_ms": {
      "type": "integer",
      "minimum": 0
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "symbol": {
            "type": "string",
            "pattern": "^par:.+$"
          },
          "asof_ms": {
            "type": "integer",
            "minimum": 0
          },
          "expires_ms": {
            "type": "integer",
            "minimum": 0
          },
          "horizon_ms": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "ready",
              "abstain",
              "error"
            ]
          },
          "direction": {
            "enum": [
              "up",
              "down",
              "neutral",
              null
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reason": {
            "type": "string"
          },
          "expected_return": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
              },
              {
                "type": "null"
              }
            ]
          },
          "prob_up": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
              },
              {
                "type": "null"
              }
            ]
          },
          "prob_down": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
              },
              {
                "type": "null"
              }
            ]
          },
          "forecast_vol": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
              },
              {
                "type": "null"
              }
            ]
          },
          "quantiles": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "distribution_ref": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "calibration_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "minLength": 1
          },
          "model_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "minLength": 1
          },
          "prompt_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "minLength": 1
          }
        },
        "required": [
          "symbol",
          "asof_ms",
          "expires_ms",
          "horizon_ms",
          "status",
          "direction",
          "evidence_refs"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "ready"
                }
              }
            },
            "then": {
              "properties": {
                "direction": {
                  "enum": [
                    "up",
                    "down",
                    "neutral"
                  ]
                }
              }
            },
            "else": {
              "properties": {
                "direction": {
                  "type": "null"
                },
                "expected_return": {
                  "type": "null"
                },
                "prob_up": {
                  "type": "null"
                },
                "prob_down": {
                  "type": "null"
                },
                "forecast_vol": {
                  "type": "null"
                },
                "quantiles": {
                  "type": "null"
                },
                "distribution_ref": {
                  "type": "null"
                }
              }
            }
          }
        ]
      }
    },
    "schema_version": {
      "type": "string",
      "const": "forecast/0.1",
      "minLength": 1
    }
  },
  "required": [
    "forecast_batch_id",
    "context_id",
    "producer_id",
    "producer_version",
    "created_ms",
    "items",
    "schema_version"
  ],
  "additionalProperties": false
}
