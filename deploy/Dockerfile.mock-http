# Reuse the pinned runtime image built by deploy/Dockerfile.
FROM perpetual-alpha-runtime:ci
USER root
COPY config/mock-http.toml /app/config/mock-http.toml
COPY config/paper-execution.synthetic.json /app/config/paper-execution.synthetic.json
RUN mkdir -p /data /state && chown 1000:1000 /data /state
USER 1000:1000
CMD ["python", "-u", "-m", "perpetual_alpha.runtime.http_core", "--host", "0.0.0.0", "--credentials", "/run/secrets/core-auth", "--database", "/data/runtime.sqlite3", "--journal", "/data/mock.sqlite3"]
